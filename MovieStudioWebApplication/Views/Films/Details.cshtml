@model MovieStudioWebApplication.Models.Film

@{
    ViewBag.Title = "Подробности";
}

<h2>Подробности</h2>

<div>
    <h4>Фильм</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Режиссер
        </dt>

        <dd>
            @Model.Director.FirstName @Model.Director.LastName
        </dd>

        <dt>
            Студия
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Studio.Name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Title)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Title)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.ReleaseYear)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.ReleaseYear)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DurationMinutes)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DurationMinutes)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Budget)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Budget)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.BoxOffice)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.BoxOffice)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Rating)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Rating)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Synopsis)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Synopsis)
        </dd>

        <dt>
            Актеры
        </dt>

        <dd>
            @if (Model.FilmActors != null && Model.FilmActors.Count > 0)
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var filmActor in Model.FilmActors)
                    {
                        if (filmActor.Actor == null)
                        {
                            continue;
                        }
                        <li>
                            @filmActor.Actor.FirstName @filmActor.Actor.LastName
                            @if (!string.IsNullOrWhiteSpace(filmActor.Role))
                            {
                                @: — @filmActor.Role
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <span>Нет данных</span>
            }
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Редактировать", "Edit", new { id = Model.FilmID }) |
    @Html.ActionLink("Вернуться к списку", "Index")
</p>
